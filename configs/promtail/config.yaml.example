# /etc/promtail/config.yaml
#
# Copy to /etc/promtail/config.yaml and fill in the placeholders.
# See docs/06-log-pipeline.md for context, especially the note
# about the `labels:` stage being required for geoip fields to
# actually reach Loki.

server:
  http_listen_port: 9080
  grpc_listen_port: 0

positions:
  filename: /tmp/positions.yaml

clients:
  - url: http://<MONITORING_HOST_IP>:3100/loki/api/v1/push

scrape_configs:
  - job_name: cowrie
    static_configs:
      - targets:
          - localhost
        labels:
          job: cowrie
          __path__: /home/cowrie/cowrie/var/log/cowrie/cowrie.json
    pipeline_stages:
      - json:
          expressions:
            src_ip: src_ip
            eventid: eventid
            username: username
            password: password
      - geoip:
          db: /etc/promtail/GeoLite2-City.mmdb
          source: src_ip
          db_type: city
      - labels:
          geoip_city_name:
          geoip_country_name:
          geoip_country_code:
          geoip_location_latitude:
          geoip_location_longitude:
