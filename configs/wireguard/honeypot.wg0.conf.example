# /etc/wireguard/wg0.conf — honeypot side
#
# Copy to /etc/wireguard/wg0.conf and fill in the placeholders.
# See docs/05-wireguard-tunnel.md for the full explanation of why
# AllowedIPs is 0.0.0.0/0 and what the PostUp/PreDown rules do.

[Interface]
PrivateKey = <HONEYPOT_PRIVATE_KEY>
Address = 10.200.200.2/24
Table = off
PostUp = ip rule add from 10.200.200.2 table 51820; ip route add default dev wg0 table 51820
PreDown = ip rule del from 10.200.200.2 table 51820; ip route del default dev wg0 table 51820

[Peer]
PublicKey = <VPS_PUBLIC_KEY>
Endpoint = <VPS_PUBLIC_IP>:51820
AllowedIPs = 0.0.0.0/0
PersistentKeepalive = 25
